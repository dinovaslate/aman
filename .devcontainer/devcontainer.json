{
  "name": "Flutter Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter", "ms-vscode.cpptools"]
    }
  },
  "postCreateCommand": "flutter --version && flutter doctor && flutter pub get || true",
  "remoteUser": "vscode"
}
